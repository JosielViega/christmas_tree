# Copy manually to /home/CPANEL_USER/christmas-tree-production/.env.
# Temporary production host: https://natal.jzlcode.com.br
# Never upload a populated .env from a developer machine.
APP_NAME="Christmas Tree"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://natal.jzlcode.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_CACHE_PATH=/home/CPANEL_USER/christmas-tree-production/storage/cache
APP_LOG_PATH=/home/CPANEL_USER/christmas-tree-production/storage/logs

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=christmas_tree_production_session
SESSION_SECURE=true
SESSION_LIFETIME_SECONDS=7200
TREE_ACCESS_COOKIE_NAME=christmas_tree_production_access
TREE_ACCESS_LIFETIME_DAYS=90
VISITOR_IDENTITY_COOKIE_NAME=christmas_tree_production_visitor
VISITOR_IDENTITY_LIFETIME_DAYS=90

MEMORY_STORAGE_PATH=/home/CPANEL_USER/christmas-tree-production/storage/private/memories
MEMORY_MAX_INPUT_BYTES=8388608
MEMORY_MAX_REQUEST_BYTES=8650752
GIFT_PRIVATE_STORAGE_PATH=/home/CPANEL_USER/christmas-tree-production/storage/private/gift-textures
GIFT_TEXTURE_MAX_BYTES=2097152
GIFT_REQUEST_MAX_BYTES=2359296

MESSAGE_REVEAL_AT="2026-12-25 00:00:00"
MESSAGE_REVEAL_TIMEZONE=America/Sao_Paulo
LIBERAR_MENSAGEM=false

# Initial temporary production deployment: every financial capability is off.
# Keep credentials empty until a separate production-payment authorization.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=mercadopago
PAYMENTS_ENVIRONMENT=production
PAYMENTS_ALLOW_PRODUCTION=false
PAYMENTS_SANDBOX_APRO=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENTS_PIX_EXPIRATION_MINUTES=1440
PAYMENTS_RECONCILIATION_BATCH_SIZE=20

# Commercial catalog remains unchanged while payments are disabled.
GIFT_PRICE_VERSION=2026-11
GIFT_PRICE_SPECIAL_CENTS=199
GIFT_PRICE_PERSONALIZED_CENTS=399
GIFT_PRICE_MAGIC_CENTS=599
